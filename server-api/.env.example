# Copy to .env and fill in. NEVER commit .env or real secrets.
PORT=3000
HOST=0.0.0.0
# Must be a replica set (one node is enough): trades use transactions. The server refuses to start otherwise.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=zenonia
# >= 32 chars, random. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me
# Shared secret the zone servers send as the x-service-key header (>= 16 chars).
SERVICE_KEY=change-me-service-key
# Public address returned by POST /characters/:id/enter (phase 4 replaces this with a zone registry).
ZONE_ID=frost-hollow
ZONE_HOST=127.0.0.1
ZONE_PORT=9050
# Set true when behind a reverse proxy so rate limits see the real client IP.
TRUST_PROXY=false
# Where the link in the password reset mail points. The API serves the page at /reset.
PASSWORD_RESET_URL=http://localhost:3000/reset
# Password reset mail. All of SMTP_HOST, SMTP_USER, SMTP_PASS, SMTP_FROM filled = real mail. Otherwise the link is logged (outside
# NODE_ENV=production; in production nothing about it is logged, startup warns that no mail goes out).
# Port 587 with SMTP_SECURE=false is STARTTLS; SMTP_SECURE=true is implicit TLS (port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional tuning (defaults shown)
# ACCESS_TTL_SEC=900
# REFRESH_TTL_SEC=2592000
# TICKET_TTL_SEC=60
# SESSION_LOCK_SEC=90
# BCRYPT_COST=11
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SEC=900
# LOGIN_IP_MAX=30
# LOGIN_IP_WINDOW_SEC=60
# REGISTER_IP_MAX=5
# REGISTER_IP_WINDOW_SEC=3600
# RESET_TTL_SEC=3600
# RESET_MAIL_COOLDOWN_SEC=60
