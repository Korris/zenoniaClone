# Copy to .env and fill in. NEVER commit .env or real secrets.
PORT=3000
HOST=0.0.0.0
MONGO_URI=mongodb://localhost:27017
MONGO_DB=zenonia
# >= 32 chars, random. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me
# Shared secret the zone servers send as the x-service-key header (>= 16 chars).
SERVICE_KEY=change-me-service-key
# Public address returned by POST /characters/:id/enter (phase 4 replaces this with a zone registry).
ZONE_ID=frost-hollow
ZONE_HOST=127.0.0.1
ZONE_PORT=9050
# Set true when behind a reverse proxy so rate limits see the real client IP.
TRUST_PROXY=false
# Password reset stub: the link is LOGGED, not mailed.
PASSWORD_RESET_URL=http://localhost:3000/reset
# Optional tuning (defaults shown)
# ACCESS_TTL_SEC=900
# REFRESH_TTL_SEC=2592000
# TICKET_TTL_SEC=60
# SESSION_LOCK_SEC=90
# BCRYPT_COST=11
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SEC=900
# LOGIN_IP_MAX=30
# LOGIN_IP_WINDOW_SEC=60
# REGISTER_IP_MAX=5
# REGISTER_IP_WINDOW_SEC=3600
