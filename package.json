{
  "name": "zenonia-web",
  "version": "0.1.0",
  "description": "Zenonia-style chibi pixel action RPG for the browser (vanilla JS + Canvas)",
  "type": "module",
  "scripts": {
    "wizard:staffs": "python tools/cut-wizard-staff-overlays.py",
    "wizard:weaponless": "python tools/build-wizard-weaponless.py && python tools/estimate-wizard-staff-anchors.py",
    "start": "npx serve . -l 5173",
    "test": "node --test tests/*.test.js",
    "check:browser": "node tools/browser-check.mjs",
    "sprites:build": "python tools/build-hero-sprites.py",
    "sprites:validate": "python tools/validate_sprites.py",
    "weapons:overlays": "python tools/cut-weapon-overlays.py",
    "hd:build": "python tools/build-hd-hero.py",
    "hd:wizard": "python tools/build-hd-hero.py assets/hd/wizard assets/hd/wizard/normalized",
    "hd:mechanic": "python tools/build-hd-hero.py assets/hd/mechanic assets/hd/mechanic/normalized && python tools/build-mechanic-fx.py",
    "hd:tiles": "python tools/build-hd-tiles.py",
    "hd:props": "python tools/build-hd-props.py",
    "hd:npcs": "python tools/build-hd-npcs.py",
    "hd:village": "python tools/build-oakhaven-village-art.py",
    "hd:frost": "python tools/build-frost-hollow-art.py",
    "hd:monsters": "python tools/build-hd-monsters-v2.py"
  },
  "license": "MIT",
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  }
}
