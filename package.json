{
  "name": "zenonia-web",
  "version": "0.1.0",
  "description": "Zenonia-style chibi pixel action RPG for the browser (vanilla JS + Canvas)",
  "type": "module",
  "scripts": {
    "start": "npx serve . -l 5173",
    "test": "node --test tests/*.test.js",
    "check:browser": "node tools/browser-check.mjs",
    "sprites:build": "python tools/build-hero-sprites.py",
    "sprites:validate": "python tools/validate_sprites.py",
    "hd:build": "python tools/build-hd-hero.py",
    "hd:tiles": "python tools/build-hd-tiles.py",
    "hd:props": "python tools/build-hd-props.py",
    "hd:npcs": "python tools/build-hd-npcs.py",
    "hd:village-props": "python tools/build-village-landmarks.py"
  },
  "license": "MIT",
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  }
}
