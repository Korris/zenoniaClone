# One new site for the host's nginx. It touches no other site and is not a default_server.
# Render (only these two variables, nginx's own $host etc. must stay), then see docs/deploy.md:
#   DOMAIN=pocketvalor.luckyday.io.vn API_PORT=3000 envsubst '${DOMAIN} ${API_PORT}' \
#     < deploy/nginx/zenonia.conf.template | sudo tee /etc/nginx/sites-available/zenonia.conf
# certbot --nginx later adds the HTTPS part to this file by itself.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    server_tokens off;
    client_max_body_size 64k; # public requests are small; only the zone sends large ones, and it does not come through here

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # $remote_addr, not $proxy_add_x_forwarded_for: the API (TRUST_PROXY=true) believes the leftmost entry, so appending would let
    # a client pick its own IP and walk around every rate limit.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    # Zone server routes: never from outside. The zone talks to the API inside Docker.
    location = /internal { return 404; }
    location ^~ /internal/ { return 404; }

    location = /health { proxy_pass http://127.0.0.1:${API_PORT}; }
    location /auth/ { proxy_pass http://127.0.0.1:${API_PORT}; }
    location = /characters { proxy_pass http://127.0.0.1:${API_PORT}; }
    location /characters/ { proxy_pass http://127.0.0.1:${API_PORT}; }

    # The reset page. Nginx's normal log line holds the query string, so this location writes none: the mail puts the token in a
    # #fragment, which no server sees, and this covers a link somebody passes with ?token= by mistake.
    location = /reset {
        access_log off;
        proxy_pass http://127.0.0.1:${API_PORT};
    }

    # Everything else is not ours to answer.
    location / { return 404; }
}
