# Production settings. Copy to .env.prod, fill in, never commit it (deploy/.gitignore ignores it). Guide: docs/deploy.md
# Used as: docker compose --env-file .env.prod -f docker-compose.prod.yml ...

# ---- Must be filled: the stack refuses to start while these are empty ----
# The domain of this server, without https://, e.g. pocketvalor.luckyday.io.vn. Its DNS A record must point straight at the VPS.
DOMAIN=
# Random, at least 32 characters. Generate with: openssl rand -hex 48
JWT_SECRET=
# Random, at least 16 characters, shared with the zone server. Generate with: openssl rand -hex 32
SERVICE_KEY=

# Connection string of your MongoDB, with its password. Needed when running under pm2. Must be a replica set (Atlas always is); the API refuses to start otherwise.
MONGO_URI=
MONGO_DB=zenonia

# ---- Password reset mail, Gmail: while one of the three below is empty the API starts, warns, and sends no mail ----
SMTP_HOST=smtp.gmail.com
# 587 with SMTP_SECURE=false is STARTTLS. Do not use implicit TLS here.
SMTP_PORT=587
SMTP_SECURE=false
# Your Gmail address, e.g. someone@gmail.com
SMTP_USER=
# A Google App Password (16 letters, write it without spaces), NOT the account password. Needs 2-Step Verification on: myaccount.google.com/apppasswords
SMTP_PASS=
# The sender. Use the same Gmail address: Gmail shows that address anyway. e.g. Pocket Valor <someone@gmail.com>
SMTP_FROM=

# ---- Ports ----
# Port of the API on this machine's loopback, where nginx finds it. Change it if 3000 is taken, and use the same number in the nginx file.
API_PORT=3000
# Public UDP port of the zone server. Open it in the firewall.
ZONE_PORT=9050

# ---- Optional (defaults shown) ----
# The address clients connect to for the game. Empty = DOMAIN.
ZONE_HOST=
ZONE_ID=frost-hollow
# Where the Unity Linux player was uploaded, and its executable.
ZONE_BUILD_DIR=./zone/build
ZONE_EXECUTABLE=Zenonia.x86_64
# Extra arguments for the zone, e.g. --max-players 100
ZONE_EXTRA_ARGS=
# Daily mongodump: when (UTC, 19:00 = 02:00 in Vietnam), where, and for how many days.
BACKUP_TIME_UTC=19:00
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Memory Mongo may use for its cache, in GB.
MONGO_CACHE_GB=0.5
# Per IP limits. Mobile networks put many players behind one IP: raise these if players are refused.
LOGIN_IP_MAX=30
REGISTER_IP_MAX=5
