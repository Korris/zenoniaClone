<Project Sdk="Microsoft.NET.Sdk">
  <!-- Scale smoke: N light protocol clients in ONE process (no Unity) against a real zone server. Run: dotnet run -c Release, then pass the swarm options after a double dash separator -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0618;CS0649;CS0169;CS8632</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\..\Assets\Plugins\LiteNetLib\**\*.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Net\Protocol\**\*.cs" />
    <!-- The real map rows (Program.Map.cs: spawn ring, path back to the goal) against the engine stand-ins the map tests use -->
    <Compile Include="..\..\..\Assets\Scripts\Rpg\WorldFlags.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Maps\*.cs" Exclude="..\..\..\Assets\Scripts\Maps\MapScenery.cs;..\..\..\Assets\Scripts\Maps\MapTransfer.cs;..\..\..\Assets\Scripts\Maps\MapPortalBeam.cs;..\..\..\Assets\Scripts\Maps\MapPortalHaze.cs;..\..\..\Assets\Scripts\Maps\MapPortalLightFx.cs;..\..\..\Assets\Scripts\Maps\MapPortalLightLook.cs" />
    <Compile Include="..\ZenoniaNet.Tests\MapGraphStubs.cs" Link="MapGraphStubs.cs" />
  </ItemGroup>
</Project>
