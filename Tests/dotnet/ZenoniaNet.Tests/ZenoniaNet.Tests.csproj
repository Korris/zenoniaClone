<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity-side protocol sources (pure C#) + vendored LiteNetLib directly, no Unity needed: dotnet test Tests/dotnet/ZenoniaNet.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0618;CS0649;CS0169;CS8632</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\..\Assets\Plugins\LiteNetLib\**\*.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Net\Protocol\**\*.cs" />
    <Compile Include="..\..\..\Assets\Scripts\World\BossRespawnTimer.cs" />
    <!-- The real map data, against the small engine stand-ins in MapGraphStubs.cs: portal graph checks for every registered map. -->
    <Compile Include="..\..\..\Assets\Scripts\Maps\*.cs" Exclude="..\..\..\Assets\Scripts\Maps\MapScenery.cs;..\..\..\Assets\Scripts\Maps\MapTransfer.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>
</Project>
